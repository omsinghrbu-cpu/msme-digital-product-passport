# Required: use the same random secret for AGENT_SERVICE_API_KEY in server/.env.
AGENT_API_KEY=replace-with-a-long-random-secret

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Your SMTP server and the sender address accepted by that server.
SMTP_HOST=
SMTP_FROM_EMAIL=

# Optional: needed by SMTP providers that require authentication.
# SMTP_USERNAME=you@example.com
# SMTP_PASSWORD=your-smtp-password
